---
import Base from './Base.astro';
import Cta from '../components/Cta.astro';
import PageBanner from '../components/PageBanner.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
const { title, metaTitle, description, crumbs, eyebrow, html, cta = true, waText, schema, noindex, related = [] } = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, '');
const plain = ['/about', '/404', '/terms', '/privacy', '/accessibility', '/sketch'].includes(path);
const useWork = path.startsWith('/blog') || path === '/tattoo-beer-sheva';
const ctaByPath = {
  '/blog/new-tattoo-care': ['יש שאלה על ההחלמה?', 'שלחו הודעה בוואטסאפ, ואם צריך גם תמונה של האזור.'],
  '/blog/tattoo-and-sun': ['יש שאלה על ההחלמה?', 'שלחו הודעה בוואטסאפ, ואם צריך גם תמונה של האזור.'],
  '/blog/piercing-healing-time': ['יש שאלה על ההחלמה?', 'שלחו הודעה בוואטסאפ, ואם צריך גם תמונה של האזור.'],
  '/blog/tattoo-price': ['רוצים הצעת מחיר?', 'שלחו בוואטסאפ את הרעיון, את הגודל בסנטימטרים ואת המקום בגוף.'],
  '/blog/does-tattoo-hurt': ['קעקוע ראשון ויש שאלות?', 'שלחו הודעה בוואטסאפ, ודוד יסביר מה מחכה לכם.'],
  '/blog/tattoo-preparation': ['קעקוע ראשון ויש שאלות?', 'שלחו הודעה בוואטסאפ, ודוד יסביר מה מחכה לכם.'],
  '/blog/first-piercing': ['רוצים לקבוע פירסינג?', 'שלחו הודעה בוואטסאפ, וספרו איזה פירסינג אתם רוצים.'],
  '/studio': ['רוצים לבוא לראות את הסטודיו?', 'שלחו הודעה בוואטסאפ ונקבע מועד.'],
  '/visit': ['רוצים לתאם הגעה מרחוק?', 'שלחו הודעה בוואטסאפ ונתחיל מהסקיצה.'],
  '/private-lessons': ['רוצים ללמוד אצל דוד?', 'שלחו הודעה בוואטסאפ ונספר לכם את כל הפרטים.'],
};
const cta2 = ctaByPath[path] || [];
---
<Base title={metaTitle} description={description} crumbs={crumbs} waText={waText} schema={schema} noindex={noindex}>
  <article class="wrap narrow">
    {!plain && <PageBanner kind={useWork ? 'work' : 'studio'} seed={path} />}
    <header class={plain ? 'page-head' : 'page-head has-banner'}>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
    </header>
    {html ? <div class="prose" set:html={html} /> : <div class="prose"><slot /></div>}
    {cta && <Cta title={cta2[0]} text={cta2[1]} waText={waText} />}
    {!['/404', '/terms', '/privacy', '/accessibility'].includes(path) && <RelatedLinks extra={related} current={path} />}
  </article>
</Base>
