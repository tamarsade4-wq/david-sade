---
import Base from './Base.astro';
import Cta from '../components/Cta.astro';
const { title, metaTitle, description, crumbs, eyebrow, html, cta = true, waText, schema, noindex } = Astro.props;
---
<Base title={metaTitle} description={description} crumbs={crumbs} waText={waText} schema={schema} noindex={noindex}>
  <article class="wrap narrow">
    <header class="page-head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
    </header>
    {html ? <div class="prose" set:html={html} /> : <div class="prose"><slot /></div>}
    {cta && <Cta waText={waText} />}
  </article>
</Base>
