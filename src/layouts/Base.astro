---
import '../styles/global.css';
import '../styles/luxe.css';
import SocialIcons from '../components/SocialIcons.astro';
import { business, wa } from '../data/site.js';
import { buildNav } from '../data/nav.js';
const mainNav = buildNav();

const {
  title,            // <title> – עד 60 תווים
  description,      // מטא – עד 155 תווים
  crumbs = [],      // [{label, href}] בלי דף הבית
  schema = [],      // JSON-LD נוסף לעמוד
  waText = 'היי דוד, הגעתי מהאתר ואשמח לפרטים',
  noindex = false,
} = Astro.props;

const site = Astro.site.href.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = site + (path === '/' ? '/' : path);
const current = path;

const org = {
  '@context': 'https://schema.org',
  '@type': 'TattooParlor',
  '@id': site + '/#business',
  name: business.name,
  url: site + '/',
  telephone: business.phoneIntl,
  email: business.email,
  slogan: business.slogan,
  areaServed: ['עומר', 'באר שבע', 'הנגב', 'ישראל'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: business.city,
    addressRegion: business.region,
    addressCountry: 'IL',
    ...(business.street ? { streetAddress: business.street } : {}),
  },
  image: [site + '/og.jpg', site + '/images/david-at-work.webp'],
  logo: site + '/images/logo-david-sade.webp',
  founder: { '@type': 'Person', '@id': site + '/about#david', name: 'דוד שדה' },
  knowsAbout: ['קעקוע ריאליסטי בשחור-אפור', 'קאבר לקעקוע', 'פורטרט', 'קעקוע הנצחה', 'פירסינג'],
  ...(business.hours ? { openingHours: business.hours } : {}),
  sameAs: [business.instagram, business.facebook].filter(Boolean),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ label: 'דף הבית', href: '/' }, ...crumbs].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: site + (c.href === '/' ? '/' : c.href),
  })),
};
const schemas = [org, ...(crumbs.length ? [breadcrumbSchema] : []), ...schema];
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
  
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="he_IL" />
  <meta property="og:site_name" content={business.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={site + '/og.jpg'} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:alt" content="דוד שדה – סטודיו לקעקועים ופירסינג ליד באר שבע" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0b0b0b" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <link rel="sitemap" href="/sitemap-index.xml" />
  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <div class="progress" aria-hidden="true"></div>
  <a class="skip-link" href="#main">דלג לתוכן</a>
  <header class="site-header">
    <div class="wrap header-row">
      <a class="brand" href="/">
        <img class="brand-logo" src="/images/logo-david-sade.webp" alt="דוד שדה, סטודיו לקעקועים. לדף הבית" width="64" height="64" fetchpriority="high" />
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        תפריט
      </button>
      <nav id="main-nav" class="main-nav" aria-label="ניווט ראשי">
        <ul>
          {mainNav.map((n) => {
            const inSection = n.match.some((m) => current === m || current.startsWith(m + '/'));
            return (
              <li class={n.groups ? (n.href === '/about' ? 'has-sub sub-end' : 'has-sub') : undefined}>
                <a href={n.href} aria-current={current === n.href ? 'page' : undefined} class={inSection ? 'in-section' : undefined}>{n.label}</a>
                {n.groups && (
                  <div class="subnav">
                    {n.groups.map((g) => (
                      <div class="sub-col">
                        {n.groups.length > 1 && <p class="sub-title">{g.title}</p>}
                        <ul>
                          {g.links.map((l) => (
                            <li><a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a></li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                )}
              </li>
            );
          })}
          <li class="nav-cta"><a class="btn btn-gold" href={wa(waText)}>לקביעת ייעוץ</a></li>
          <li class="nav-social"><SocialIcons waText={waText} /></li>
        </ul>
      </nav>
    </div>
  </header>

  {crumbs.length > 0 && (
    <nav class="wrap breadcrumbs" aria-label="פירורי לחם">
      <ol>
        <li><a href="/">דף הבית</a></li>
        {crumbs.map((c, i) => i === crumbs.length - 1
          ? <li aria-current="page">{c.label}</li>
          : <li><a href={c.href}>{c.label}</a></li>)}
      </ol>
    </nav>
  )}

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <img class="footer-logo" src="/images/logo-david-sade.webp" alt="לוגו דוד שדה, Tattoo Artist" width="72" height="72" loading="lazy" />
          <h2>{business.name}</h2>
          <p>הסיפור שלך. האמנות שלנו.</p>
          <p class="insight">{business.slogan}</p>
        </div>
        <div>
          <h2>קעקועים</h2>
          <ul>
            <li><a href="/tattoos">כל הקעקועים</a></li>
            <li><a href="/tattoos/realism">ריאליזם שחור-אפור</a></li>
            <li><a href="/tattoos/cover-up">קאבר לקעקוע ישן</a></li>
            <li><a href="/tattoos/small-fine-line">קטנים ופיין ליין</a></li>
            <li><a href="/tattoos/consultation">ייעוץ וסקיצה</a></li>
            <li><a href="/portfolio">תיק עבודות</a></li>
          </ul>
        </div>
        <div>
          <h2>פירסינג</h2>
          <ul>
            <li><a href="/piercing">כל סוגי הפירסינג</a></li>
            <li><a href="/piercing/helix">הליקס</a></li>
            <li><a href="/piercing/nose">אף</a></li>
            <li><a href="/piercing/septum">ספטום</a></li>
            <li><a href="/piercing/titanium-jewelry">תכשיטי טיטניום</a></li>
          </ul>
        </div>
        <div>
          <h2>הסטודיו</h2>
          <ul>
            <li><a href="/about">אודות דוד שדה</a></li>
            <li><a href="/studio">סטודיו פרטי</a></li>
            <li><a href="/tattoo-beer-sheva">מקעקע בבאר שבע</a></li>
            <li><a href="/visit">מגיעים מרחוק</a></li>
            <li><a href="/private-lessons">לימוד פרטני</a></li>
            <li><a href="/press">כתבו עלינו</a></li>
            <li><a href="/blog">מאמרים</a></li>
          </ul>
        </div>
        <div>
          <h2>צרו קשר</h2>
          <ul>
            <li>עומר, צמוד לבאר שבע</li>
            <li><a href={wa(waText)}>וואטסאפ: {business.phoneDisplay}</a></li>
            <li><a href={`tel:${business.phoneIntl}`}>טלפון: {business.phoneDisplay}</a></li>
            <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
            <li><a class="social-link" href={business.instagram} rel="noopener" target="_blank">
              <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".6" fill="currentColor"/></svg>
              <span>אינסטגרם</span><span class="sr-only"> (נפתח בחלון חדש)</span></a></li>
            <li><a class="social-link" href={business.facebook} rel="noopener" target="_blank">
              <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5A.5.5 0 0 1 14 8z"/></svg>
              <span>פייסבוק</span><span class="sr-only"> (נפתח בחלון חדש)</span></a></li>
          </ul>
        </div>
      </div>
      <div class="legal">
        <a href="/terms">תקנון</a> · <a href="/privacy">מדיניות פרטיות</a> · <a href="/accessibility">הצהרת נגישות</a>
        <p>© {new Date().getFullYear()} {business.name}</p>
      </div>
    </div>
  <a class="wa-float" href={wa(waText)} aria-label="שליחת הודעה בוואטסאפ לדוד שדה">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.15c-.24.68-1.41 1.3-1.95 1.35-.5.05-.97.24-3.27-.68-2.77-1.09-4.53-3.93-4.67-4.11-.13-.18-1.11-1.48-1.11-2.83 0-1.34.7-2 .95-2.28.25-.27.54-.34.72-.34h.52c.17 0 .39-.06.61.47.24.56.79 1.92.86 2.06.07.13.11.3.02.48-.09.18-.13.29-.27.45-.13.16-.28.36-.4.48-.13.13-.27.28-.12.55.16.27.7 1.15 1.5 1.86 1.03.92 1.9 1.2 2.17 1.34.27.13.43.11.59-.07.16-.18.68-.79.86-1.06.18-.27.36-.23.61-.14.25.09 1.59.75 1.86.89.27.13.45.2.52.31.07.11.07.65-.17 1.33z"/></svg>
  </a>
  </footer>



  <script>
    const bar = document.querySelector('.progress');
    let tick = false;
    const upd = () => {
      tick = false;
      const h = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = `scaleX(${h > 0 ? Math.min(scrollY / h, 1) : 0})`;
      document.body.classList.toggle('scrolled', scrollY > 40);
    };
    addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(upd); } }, { passive: true });
    upd();
    const io = 'IntersectionObserver' in window ? new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' }) : null;
    document.querySelectorAll('.reveal').forEach((el) => io ? io.observe(el) : el.classList.add('in'));
    const t = document.querySelector('.nav-toggle');
    const n = document.getElementById('main-nav');
    t?.addEventListener('click', () => {
      const open = n.classList.toggle('open');
      t.setAttribute('aria-expanded', String(open));
    });
    // תפריט נפתח: Escape סוגר, ומתאפס ביציאת העכבר או המיקוד
    document.querySelectorAll('.has-sub').forEach((li) => {
      const reset = () => li.classList.remove('dismissed');
      li.addEventListener('mouseleave', reset);
      li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget)) reset(); });
      li.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && li.matches(':hover, :focus-within')) {
          li.classList.add('dismissed');
          li.querySelector(':scope > a')?.focus();
          e.stopPropagation();
        }
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && n.classList.contains('open')) {
        n.classList.remove('open'); t.setAttribute('aria-expanded', 'false'); t.focus();
      }
    });
  </script>
</body>
</html>
