---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import PageBanner from '../../components/PageBanner.astro';
import { tattoos } from '../../data/services.js';

export function getStaticPaths() {
  return tattoos.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const others = tattoos.filter((t) => t.slug !== s.slug);
const service = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: s.title, serviceType: 'קעקוע', description: s.description,
  provider: { '@id': Astro.site.href.replace(/\/$/, '') + '/#business' },
  areaServed: ['עומר', 'באר שבע', 'ישראל'],
};
---
<Base title={s.metaTitle} description={s.description} waText={s.waText}
  crumbs={[{ label: 'קעקועים', href: '/tattoos' }, { label: s.title, href: `/tattoos/${s.slug}` }]}
  schema={[service]}>
  <article class="wrap narrow">
    <PageBanner kind="work" seed={s.slug} />
    <header class="page-head has-banner">
      <p class="eyebrow">קעקועים</p>
      <h1>{s.title}</h1>
    </header>
    <div class="prose" set:html={s.body} />
    <Cta waText={s.waText} />
    <nav class="related" aria-label="עוד שירותי קעקוע">
      <h2>עוד שירותי קעקוע</h2>
      <ul>{others.map((o) => <li><a href={`/tattoos/${o.slug}`}>{o.title}</a></li>)}</ul>
    </nav>
    <RelatedLinks current={Astro.url.pathname} />
  </article>
</Base>
